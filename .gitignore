htmlcov/

# Secrets and environment
.env
.env.*

# Generated backlog workbook. docs/backlog/*.csv are authoritative; rebuild the
# spreadsheet view with `uv run python scripts/backlog_xlsx.py`.
*.xlsx

# Cross-model review prompts. Scaffolding, not record: generate them with
# `scripts/review-request.py <ITEM>`; the durable record is docs/*-NOTES.md.
GPT_REVIEW_*

# Hypothesis's example database (tests/property/)
.hypothesis/

# Claude Code machine-local settings. The shared project allowlist is the tracked
# .claude/settings.json; anything machine-specific belongs here instead.
.claude/settings.local.json

# Generated data (ledger, artifacts, exports, logs, snapshots)
data/
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm

# Operator-local configuration. `config.example.yaml` is the committed contract and
# `config/tournament.yaml` is what the systemd unit actually loads; a `config.yaml` in the
# repo root is a machine-local file that nothing in the program reads by default. It was
# untracked and shadowing the real one during the M1-323 incident, which is how a stale copy
# came to be read as the live config -- ignore it rather than leaving it to dirty the tree
# and block `review-request.py`.
/config.yaml
