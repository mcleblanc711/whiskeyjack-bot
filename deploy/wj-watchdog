def _now() -> datetime:
    return datetime.now(timezone.utc)


def _systemctl(*args: str, env: dict[str, str] | None = None) -> str:
    """One systemctl question. `env` is None for every caller but the timestamp reader.

    `env=None` is what `subprocess.run` was already given -- inherit -- so the four tournament
    queries and the three resolutions ones pass exactly what they passed before (M1-343). The
    alternative was a second copy of this block for the new calls, which would have been a
    second timeout and a second exception handler to keep in step with this one.
    """
    try:
        out = subprocess.run(
            ["systemctl", "--user", *args],
            capture_output=True,
            text=True,
            timeout=SYSTEMCTL_TIMEOUT_SECONDS,
            env=env,
        )
        return out.stdout.strip()
    except Exception:
        return "unknown"


def _unit_timestamp(*args: str) -> datetime | None:
    """A systemd timestamp property as an aware instant, or None when it is not one.

    `systemctl show` renders timestamp properties in the CLIENT's local time and locale, and
    `--timestamp=unix|utc|us|us+utc|pretty` does **not** change that for `show` -- measured on
    systemd 255, where all five printed `Sat 2026-09-19 06:23:18 MDT`. An abbreviated zone name
    cannot be parsed back reliably, so the answer is to ask in a controlled environment instead:
    under `TZ=UTC` and `LC_ALL=C` the same property renders `Sat 2026-09-19 12:23:18 UTC`. Only
    the two middle tokens are parsed -- the weekday is ignored precisely so that `%a`'s locale
    dependence cannot matter, and the zone token must be exactly `UTC` or nothing is parsed.

    Total by construction. A timer that has never fired and a unit that does not exist BOTH print
    the empty string; `_systemctl` substitutes "unknown" when the call itself fails; systemd
    prints "n/a" and "infinity" for unset and never-elapsing values. Every one of those, and
    arbitrary text, returns None -- which every caller reads as "no usable record", and which
    means silence rather than a page.
    """
    return _parse_unit_timestamp(_systemctl(*args, env={**os.environ, "TZ": "UTC", "LC_ALL": "C"}))


def _parse_unit_timestamp(raw: str) -> datetime | None:
    """The parsing half of `_unit_timestamp`, split out so it can be fuzzed without a subprocess."""
    parts = raw.split()
    if len(parts) != 4 or parts[3] != "UTC":
        return None
    try:
        parsed = datetime.strptime(f"{parts[1]} {parts[2]}", "%Y-%m-%d %H:%M:%S")
    except ValueError:
        return None
    return parsed.replace(tzinfo=timezone.utc)


def _aware_stamp(raw: object) -> datetime | None:
    """A stored timestamp, or None when it is not one this program can subtract from `now`.

    One parser for both subjects (M1-341 review round 2). The tournament block had its own,
    which guarded only `ValueError` on a value it had already truthiness-tested -- so four
    shapes a person can leave in the state file by hand escaped as a raw `TypeError` out of
    `main`, taking down BOTH subjects and doing it silently, since this is the one unit with no
    `OnFailure` pager. Enumerated by execution against `624da85` rather than fixed one at a
    time, because a finding that names one escaping type usually names a class:

        {"last_alert": [1]}                     TypeError: fromisoformat: argument must be str
        {"last_alert": 3}                       TypeError: fromisoformat: argument must be str
        {"last_alert": 1.5}                     TypeError: fromisoformat: argument must be str
        {"last_alert": {"a": 1}}                TypeError: fromisoformat: argument must be str
        {"last_alert": "2026-09-17T12:00:00"}   TypeError: can't subtract offset-naive and
                                                offset-aware datetimes

    The last one is the one the review did not name: it parses perfectly and fails at the
    subtraction instead. "Unusable" therefore means all three of not-a-string, unparseable and
    naive, and the answer to every one is the same -- no usable record that anyone was told,
    so tell them. The dangerous direction is silence: a throttle that trusts a bad stamp either
    raises here or waits forever.
    """
    if not isinstance(raw, str):
        return None
    try:
        parsed = datetime.fromisoformat(raw)
    except ValueError:
        return None
    return parsed if parsed.tzinfo is not None else None


def _last_heartbeat() -> datetime | None:
    """Newest heartbeat timestamp, or None. Read-only; never writes to the ledger."""
    try:
        # `exists()` is INSIDE the try, and `OSError` is caught beside `sqlite3.Error`
        # (M1-341 review round 4). `Path.exists()` does not swallow `EACCES`: a ledger
        # directory that loses search permission makes it raise `PermissionError`, which
        # escaped `main` and took the resolutions check down with it, because that check runs
        # second. Reproduced at `b08f01b` with a real `chmod 000` on the directory, under the
        # system interpreter the unit runs (3.12.3), not with a monkeypatch. CLAUDE.md keeps
        # permission failures and unreadable files explicitly in scope as reachable reliability
        # conditions, and an unreadable ledger is a heartbeat this program cannot read -- which
        # is a fault to report, not a reason to stop reporting.
        if not LEDGER.exists():
            return None
        conn = sqlite3.connect(f"file:{LEDGER}?mode=ro", uri=True, timeout=LEDGER_TIMEOUT_SECONDS)
        try:
            row = conn.execute(
                "select created_at_utc from tournament_events "
                "where kind='heartbeat' order by seq desc limit 1"
            ).fetchone()
        finally:
            conn.close()
    except (OSError, sqlite3.Error):
        return None
    if not row:
        return None
    # The THIRD stamp parser, and the third round to find the same class (M1-341 review round
    # 3). `created_at_utc` is `TEXT NOT NULL`, but SQLite is dynamically typed and applies TEXT
    # affinity, so what comes back is whatever a writer put there -- and CLAUDE.md classifies
    # values read back out of the ledger as untrusted, in as many words. A naive timestamp
    # parses fine here and then raises `TypeError: can't subtract offset-naive and offset-aware
    # datetimes` at the caller, out of `main`, taking the resolutions check down with it
    # because it runs second. Reproduced at `e8573e9` against a real ledger, with a heartbeat
    # of `2026-09-17T11:55:00`; an integer written into the column reduces to the same case,
    # because affinity converts it to `'20260917'` and `fromisoformat` reads that as a
    # basic-format naive date. One parser, the same one both throttles use.
    return _aware_stamp(row[0])


def _say(line: str) -> None:
    """Print one diagnostic line. Never raises -- M1-345.

    Every status line in this program is a diagnostic: the journal is where an operator reads
    what a run saw, and nothing downstream consumes it. A closed pipe or a full journal disk
    must therefore not take down a check, and must not suppress a push -- this is the one unit
    with no `OnFailure` pager, so a run that dies reports nothing at all.

    `ValueError` as well as `OSError`: writing to a stream that has been closed raises
    `ValueError: I/O operation on closed file`, not an `OSError`, and `sys.stdout` can be
    `None` under a launcher that gave the process no standard output at all.
    """
    try:
        print(line)
    except (OSError, ValueError, AttributeError):
        pass


def _quiet_shutdown() -> None:
    """Flush what was buffered, and make the interpreter's own final flush harmless.

    Measured, not assumed (M1-345): with stdout a closed pipe, three short lines fit in the
    buffer, so every `print` SUCCEEDS and the `BrokenPipeError` arrives during interpreter
    shutdown -- after `main` has returned. CPython then reports **exit code 120 whatever
    `main` returned**, so a healthy run reads as a failure and a real fault loses its own
    code. Guarding the prints alone cannot fix that; the buffer has to be dealt with.

    So: flush here, where a failure can be caught, and if it fails point fd 1 at /dev/null and
    flush again. The buffered bytes are then discarded to the null device, shutdown has
    nothing left to write, and the exit status is the one the checks decided.
    """
    for stream in (sys.stdout, sys.stderr):
        try:
            if stream is not None:
                stream.flush()
        except (OSError, ValueError):
            try:
                descriptor = os.open(os.devnull, os.O_WRONLY)
            except OSError:
                continue
            try:
                os.dup2(descriptor, stream.fileno())
                stream.flush()
            except (OSError, ValueError):
                pass
            finally:
                try:
                    os.close(descriptor)
                except OSError:
                    pass


def _load_state() -> dict:
    """The state file, or an empty state. Never anything a caller cannot use as a dict.

    The top-level shape is validated, not just the parse (M1-341 review round 1). A state file
    containing `[]`, `null`, `"text"` or `3` is valid JSON, so the bare parse returned it and
    every caller's `state.get(...)` raised `AttributeError` out of `main` -- taking down BOTH
    subjects, and doing it silently, since the watchdog is the one unit with no `OnFailure`.
    Reproduced by execution at `3dda485`: `[]` in the file, a stopped resolutions timer, and
    the run died before it asked a single resolutions question. A hand-edited state file is an
    ordinary operator action, and the whole point of this file is to notice when things stop.

    M1-344: two files, not one. When STATE could not be written, the stamps went to the
    fallback in the runtime directory instead, so that file -- when it exists, is usable, and
    is NEWER than STATE -- is the current state. Newer by modification time rather than by a
    stamp inside it, because both files hold the same dict and a person may have edited either.
    A tie goes to STATE.
    """
    primary = _read_state(STATE)
    fallback_path = _fallback_state_path()
    fallback = _read_state(fallback_path) if fallback_path is not None else None
    if fallback is None:
        return primary if primary is not None else {}
    if primary is None or _mtime_ns(fallback_path) > _mtime_ns(STATE):
        return fallback
    return primary


def _read_state(path: Path) -> dict | None:
    try:
        loaded = json.loads(path.read_text())
    except Exception:
        return None
    return loaded if isinstance(loaded, dict) else None


def _mtime_ns(path: Path | None) -> int:
    try:
        return path.stat().st_mtime_ns if path is not None else -1
    except OSError:
        return -1


def _fallback_state_path() -> Path | None:
    """`$XDG_RUNTIME_DIR/wj-watchdog.json`, or None when there is no usable runtime directory.

    An unset, relative or empty value is None rather than a guess: a relative path would land
    in whatever the working directory is, which is the repo checkout.
    """
    runtime = os.environ.get("XDG_RUNTIME_DIR", "").strip()
    if not runtime or not os.path.isabs(runtime):
        return None
    path = Path(runtime) / FALLBACK_STATE_NAME
    return None if path == STATE else path


def _errno_name(exc: OSError) -> str:
    """`EACCES`, `EROFS`, `ENOSPC`... never the exception's text, which can quote a path twice
    and is the platform's prose rather than this program's."""
    return errno.errorcode.get(exc.errno or 0, type(exc).__name__)


def _write_atomic(path: Path, text: str) -> None:
    """Write `text` to `path` so that a failure leaves the old file whole (M1-344).

    `write_text` truncates first and writes second, so a full disk mid-write left a
    half-written file: invalid JSON, which `_load_state` reads as an EMPTY state -- every
    throttle stamp lost at once, exactly the failure the fallback exists to prevent. Here the
    bytes go to a sibling temporary file and `os.replace` swaps it in whole; any failure
    removes the temporary file (best effort) and raises.
    """
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(f".{path.name}.{os.getpid()}.tmp")
    try:
        with open(temporary, "w", encoding="utf-8") as stream:
            stream.write(text)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, path)
    except BaseException:
        try:
            temporary.unlink(missing_ok=True)
        except OSError:
            pass
        raise


def _save_state(state: dict) -> tuple[Path | None, str | None]:
    """Persist `state`. Never raises. Returns (where it landed or None, STATE's errno name).

    **Still never raises, and that stays deliberate.** The watchdog is the one unit with no
    `OnFailure` pager, so a watchdog that dies because it could not write a stamp reports
    nothing at all. What M1-344 changes is that the failure no longer costs the throttle: the
    stamps go to the runtime-directory fallback, which `_load_state` reads back next run, and
    `_report_persistence` says so. When STATE is writable again the fallback is removed, so a
    stale copy can never shadow it (and if the removal fails, STATE is the newer file anyway).
    """
    text = json.dumps(state)
    try:
        _write_atomic(STATE, text)
    except OSError as exc:
        primary_error = _errno_name(exc)
    else:
        fallback_path = _fallback_state_path()
        if fallback_path is not None:
            try:
                fallback_path.unlink(missing_ok=True)
            except OSError:
                pass
        return STATE, None
    fallback_path = _fallback_state_path()
    if fallback_path is None:
        return None, primary_error
    try:
        _write_atomic(fallback_path, text)
    except OSError:
        return None, primary_error
    return fallback_path, primary_error


def _report_persistence(state: dict, landed: Path | None, primary_error: str | None) -> None:
    """Make a state-file failure visible without making it the reason `main` exits non-zero.

    Kept OUT of every subject's fault vocabulary on purpose (M1-343's lesson): `_throttle_key`
    hashes a subject's whole code set, so adding "state unwritable" to one would re-key every
    standing condition and page each of them once more. It has its own key, `persistence`, and
    its own 24-hour window, stamped in the same state -- which is to say in the fallback, since
    that is the only place a stamp can land while this is true.

    Three cases:

    - STATE written: nothing to say, beyond clearing a previous failure.
    - STATE failed, fallback written: a status line every run, and one push a day. The
      subjects' own windows hold, because their stamps are in the fallback.
    - Both failed: a status line every run and NO push. Nothing durable is left to stamp a
      window in, so a push here would repeat every run, and so will the subjects' pages -- which
      this line exists to explain in the journal. There is no bound to be had without storage.
    """
    if primary_error is None:
        if state.pop("persistence", None) is not None:
            _say(f"STATE: {STATE} is writable again")
            _save_state(state)
        return
    if landed is None:
        _say(
            f"STATE: cannot write {STATE} ({primary_error}) or the runtime-directory fallback; "
            "throttle windows cannot hold, so standing faults page on every run"
        )
        return
    _say(f"STATE: cannot write {STATE} ({primary_error}); stamps kept in {landed} instead")
    stored = state.get("persistence")
    if not isinstance(stored, dict):
        stored = {}
    last_alert = _aware_stamp(stored.get("last_alert"))
    now = _now()
    if last_alert is not None and timedelta(0) <= now - last_alert < PERSISTENCE_REALERT_AFTER:
        return
    body = (
        f"The watchdog cannot write its state file {STATE} ({primary_error}).\n\n"
        f"Its throttle stamps are being kept in {landed}, which is cleared at reboot, so each "
        "standing fault may page once more after a restart. Every check still runs.\n\n"
        f"Check: ls -l {STATE}; df -h {STATE.parent}"
    )
    delivered = _push(
        "whiskeyjack: watchdog state unwritable",
        body,
        priority="default",
        tags="warning",
        timeout=PERSISTENCE_PUSH_TIMEOUT_SECONDS,
    )
    if delivered:
        state["persistence"] = {"last_alert": now.isoformat(), "error": primary_error}
        _save_state(state)


def _push(
    title: str, body: str, *, priority: str, tags: str, timeout: int = PUSH_TIMEOUT_SECONDS
) -> bool:
    """Send one ntfy push. Never raises -- a dead channel must not kill the watchdog.

    `timeout` defaults to what every caller before M1-347 passed; only the rollover check
    passes its own, for the budget reason given at WORST_CASE_SECONDS.
    """
    topic = os.environ.get("NTFY_TOPIC_URL", "").strip()
    if not topic:
        return False
    request = urllib.request.Request(
        topic,
        data=body.encode("utf-8"),
        headers={"Title": title, "Priority": priority, "Tags": tags},
        method="POST",
    )
    try:
        with urllib.request.urlopen(request, timeout=timeout) as response:
            return 200 <= response.status < 300
    except (urllib.error.URLError, OSError, ValueError):
        return False


def _ping_deadman() -> None:
    """Optional external dead-man ping.

    The watchdog cannot report that the MACHINE is off or the user session ended -- it
    dies with them. Set WJ_HEALTHCHECK_URL (healthchecks.io or similar) and that service
    alerts when these pings stop, which is the only thing that covers a dark host.
    """
    url = os.environ.get("WJ_HEALTHCHECK_URL", "").strip()
    if not url:
        return
    try:
        urllib.request.urlopen(url, timeout=DEADMAN_TIMEOUT_SECONDS).close()
    except (urllib.error.URLError, OSError, ValueError):
        pass


def _observe(state: dict, now: datetime) -> datetime:
    """The instant since which this watchdog has been watching without a break.

    Guard D of the stall rule, and the honest witness for "the host was off" (M1-343). The
    watchdog runs every five minutes, so it is the one thing here that KNOWS whether it was
    running: a gap in its own observations is a period during which the resolutions timer could
    not be observed failing to fire, and a stall may not be claimed across one.

    `/proc/uptime` was the obvious alternative and is wrong twice: its first field is measured
    against a clock that keeps counting across suspend, so a laptop asleep for three hours looks
    like three hours of uptime, and it cannot see a user session that ended while the machine
    stayed up. Both are exactly the case this guard exists for.

    Untrusted shape throughout -- this is a file a person can edit -- so both stamps go through
    `_aware_stamp`, and a missing, unusable or future stamp resets the record rather than
    extending it. Resetting is the silent direction, which is the right one for a rule with no
    observed occurrence: it can lose a page it should have sent, never invent one.
    """
    stored = state.get("observed")
    if not isinstance(stored, dict):
        stored = {}
    since = _aware_stamp(stored.get("since"))
    last_seen = _aware_stamp(stored.get("last_seen"))
    if since is None or last_seen is None:
        since = now
    elif not timedelta(0) <= now - last_seen <= WATCHDOG_GAP_TOLERANCE:
        # Too long to be a missed run, or a clock that moved backwards under us.
        since = now
    elif since > now:
        since = now
    state["observed"] = {"since": since.isoformat(), "last_seen": now.isoformat()}
    return since


def _timer_stalled(
    timer_active: str,
    timer_enabled: str,
    last_trigger: datetime | None,
    active_since: datetime | None,
    observed_since: datetime,
    now: datetime,
) -> bool:
    """Whether an enabled, active timer has gone its interval plus the margin without firing.

    Pure, and total over arbitrary strings and over every stamp `_unit_timestamp` can return.
    Five conditions, and each one refuses a DIFFERENT false alarm, so neutering any single one
    changes what this reports:

    0. Not active, or not enabled -- the three existing codes already describe that timer, and
       the criterion is scoped to one that is running.
    A. No usable `LastTriggerUSec`: a timer that has **never fired**. Silent, per the criterion.
    B. The arithmetic: the last firing is older than the interval plus the stated margin.
    C. The timer itself has been active for that whole window. `Persistent=true` means a timer
       started after a stop fires within `AccuracySec`, so a timer restarted one minute ago has
       a week-old last trigger and is not stalled -- it is recovering, and paging then would be
       a false alarm on the path an operator has just fixed.
    D. This watchdog has been watching for that whole window (`_observe`): a host that was off,
       suspended or logged out is a gap in the record, not a fault in the timer.
    """
    window = RESOLUTIONS_INTERVAL + RESOLUTIONS_STALE_MARGIN
    if timer_active != "active" or timer_enabled != "enabled":
        return False
    if last_trigger is None:
        return False
    if now - last_trigger < window:
        return False
    if active_since is None or now - active_since < window:
        return False
    return now - observed_since >= window


def _resolutions_problems(
    timer_active: str, timer_enabled: str, service_failed: str
) -> tuple[str, ...]:
    """The codes for every fault these three systemctl answers show, sorted.

    Pure, and total over arbitrary strings: `_systemctl` returns whatever systemd printed,
    "unknown" when the call itself failed, and "" for a unit that does not exist at all.
    Anything that is not exactly "active"/"enabled" is a fault, which is the stricter
    reading and the one the tournament block already takes -- `enabled-runtime` is a real
    answer meaning "enabled until the next reboot", and it is not enabled.
    """
    codes = []
    if timer_active != "active":
        codes.append("timer_inactive")
    if timer_enabled != "enabled":
        codes.append("timer_disabled")
    if service_failed == "failed":
        codes.append("service_failed")
    return tuple(sorted(codes))


def _alert_is_due(codes: tuple[str, ...], stored: dict, now: datetime) -> bool:
    """Whether this exact fault set has gone unpaged long enough to page again.

    Pure. `stored` is read back out of a JSON file a person can edit, so every field is
    treated as untrusted shape: a missing, non-string, unparseable or naive-datetime stamp
    all mean "no usable record of a page", and the honest answer to that is to page.
    """
    if not codes:
        return False
    return _key_is_due(_throttle_key(codes), stored, now, RESOLUTIONS_REALERT_AFTER)


def _key_is_due(key: str, stored: dict, now: datetime, window: timedelta) -> bool:
    """`_alert_is_due`'s rule for an arbitrary key and window (M1-347). Pure.

    Split out rather than copied, so the rollover subject's two throttles and the resolutions
    one are the same rule: a key that is not the stored one has never been paged, and a stamp
    that cannot be read means no usable record of a page.
    """
    if stored.get("key") != key:
        return True
    last = _aware_stamp(stored.get("last_alert"))
    if last is None:
        return True
    return (now - last) >= window


def _throttle_key(codes: tuple[str, ...]) -> str:
    return ",".join(codes)


def _stall_unverified(stored: dict, last_trigger: datetime | None, now: datetime) -> bool:
    """Whether a stall already paged is still standing as far as this run can tell.

    `timer_stalled` is the one code whose absence is not evidence. The other three are read
    straight off systemd every run, so not-active becoming active IS the recovery. A stall,
    though, stops being *detectable* the moment any of its guards refuses -- and two of those
    guards refuse for reasons that say nothing whatever about the timer: guard D because the
    host was off, guard A because the query failed. The only thing that genuinely ends a stall
    is the timer firing again.

    So: a stored page that named a stall keeps naming it while the last trigger is still older
    than the window, or cannot be read at all. A trigger inside the window is the timer firing,
    which is the evidence -- and the only evidence -- that ends it.

    This is what keeps the throttle key stable across a failed query (round-1 finding: a key
    that loses a code is a new fault set, and a new fault set pages at once), and what keeps
    the recovery notice honest, since an empty code set can then only mean every fault cleared.

    `stored` came back out of a JSON file a person can edit, so `key` is read as untrusted
    shape: anything that is not a string carries no stall.
    """
    key = stored.get("key")
    if not isinstance(key, str) or "timer_stalled" not in key.split(","):
        return False
    if last_trigger is None:
        return True
    return now - last_trigger >= RESOLUTIONS_INTERVAL + RESOLUTIONS_STALE_MARGIN


def _check_resolutions(state: dict, observed_since: datetime) -> bool:
    """The six-hourly ingest-and-score schedule. True when it has stopped.

    Reads three unit states, and -- only for a timer that is active and enabled -- two of its
    timestamps (M1-343). No ledger, no config, no network beyond the one ntfy POST. `Result` and
    `ExecMainStatus` are still read only to say WHY a failed run failed, never as a detection
    rule of their own.

    The two timestamps are asked one property per call. Combining them into one `show` is what
    M1-341's round-1 review rejected for the diagnostic pair, and the reason holds here: this
    module strips systemctl's output, so a property with an empty value loses its line and the
    two can transpose silently -- and "empty" is exactly what a timer that has never fired
    answers.
    """
    timer_active = _systemctl("is-active", f"{RESOLUTIONS_UNIT}.timer") or "unknown"
    timer_enabled = _systemctl("is-enabled", f"{RESOLUTIONS_UNIT}.timer") or "unknown"
    service_failed = _systemctl("is-failed", f"{RESOLUTIONS_UNIT}.service") or "unknown"
    codes = _resolutions_problems(timer_active, timer_enabled, service_failed)

    stored = state.get("resolutions")
    if not isinstance(stored, dict):
        stored = {}

    now = _now()
    last_trigger: datetime | None = None
    if timer_active == "active" and timer_enabled == "enabled":
        last_trigger = _unit_timestamp(
            "show", f"{RESOLUTIONS_UNIT}.timer", "-p", "LastTriggerUSec", "--value"
        )
        active_since = _unit_timestamp(
            "show", f"{RESOLUTIONS_UNIT}.timer", "-p", "ActiveEnterTimestamp", "--value"
        )
        # A stall is a STANDING condition, and the only thing that ends it is the timer firing
        # again. So it is reported when this run can see it, and equally when a run that could
        # see it has already reported it and this one cannot re-check (`_stall_unverified`).
        #
        # Round-1 blocking finding, and the second clause is the whole of the fix. Dropping an
        # unverifiable stall from the code set changes the THROTTLE KEY, and a changed key is a
        # new fault set that pages at once. Reproduced by execution at `4232e12`: with the
        # service also failed and the `LastTriggerUSec` query timing out on one run in three --
        # an ordinary local failure, `_systemctl` answering "unknown" -- the key flapped
        # `service_failed,timer_stalled` -> `service_failed` -> `service_failed,timer_stalled`
        # and the schedule paged THREE times inside a window that owes one. Worse, the shrunken
        # key no longer carried the stall, so clearing the failed run while the timer was still
        # not firing sent `resolutions schedule recovered` about a stall nobody had re-checked.
        if _timer_stalled(
            timer_active, timer_enabled, last_trigger, active_since, observed_since, now
        ) or _stall_unverified(stored, last_trigger, now):
            # ADDED to the set, not substituted for it: a timer that is stalled and whose last
            # run also failed is two faults, and the throttle is keyed on the whole set, so
            # naming both is what makes the second one new information rather than a drop.
            codes = tuple(sorted({*codes, "timer_stalled"}))

    if not codes:
        # Reaching here with a stall stored is impossible by construction: an active, enabled
        # timer whose stall has not been disproved has just put `timer_stalled` back into
        # `codes`, and an inactive or disabled one has a code of its own. So an empty set really
        # does mean every fault cleared, which is what makes the recovery notice below a claim
        # this run can support.
        if stored.get("key") and RECOVERY_NOTICE:
            _push(
                "whiskeyjack: resolutions schedule recovered",
                f"{RESOLUTIONS_UNIT}.timer is {timer_active}/{timer_enabled} again. "
                "Persistent=true, so a run missed while it was stopped happens at the next "
                "start; both commands are idempotent.",
                priority="default",
                tags="white_check_mark",
            )
        state["resolutions"] = {}
        _say(f"OK: resolutions timer {timer_active}/{timer_enabled}")
        return False

    key = _throttle_key(codes)
    entry: dict = {"key": key}
    # Carry the stamp forward only while the fault set is unchanged: a different set has
    # never been paged, and must not inherit another set's throttle.
    previous = stored.get("last_alert")
    if stored.get("key") == key and isinstance(previous, str):
        entry["last_alert"] = previous

    if _alert_is_due(codes, stored, now):
        result = _systemctl("show", f"{RESOLUTIONS_UNIT}.service", "-p", "Result", "--value")
        status = _systemctl(
            "show", f"{RESOLUTIONS_UNIT}.service", "-p", "ExecMainStatus", "--value"
        )
        # An AGE in hours, computed here, rather than the timestamp systemd printed: the push
        # carries no value read out of anything, which is the project's error-hygiene rule and
        # M1-334's lesson about a subject line that is hashed.
        stalled_line = ""
        if "timer_stalled" in codes and last_trigger is not None:
            hours = (now - last_trigger).total_seconds() / 3600
            interval_hours = RESOLUTIONS_INTERVAL.total_seconds() / 3600
            margin_hours = RESOLUTIONS_STALE_MARGIN.total_seconds() / 3600
            stalled_line = (
                f"\nlast fired: {hours:.0f} h ago "
                f"(interval {interval_hours:.0f} h + margin {margin_hours:.0f} h)"
            )
        body = (
            "Resolution ingestion and scoring are NOT scheduled.\n\n"
            + "\n".join(f"- {RESOLUTIONS_PROBLEMS[code]}" for code in codes)
            + f"\n\ntimer: {timer_active}/{timer_enabled}"
            + f"\nlast run: result={result or 'unknown'} exit={status or 'unknown'}"
            + stalled_line
            + "\n\nNothing is lost while it is stopped -- ingest-resolutions and score are "
            "both idempotent and catch up -- but resolutions and scores stop arriving, and "
            "the unit's own OnFailure pager cannot report this: a timer that never runs "
            "never fails."
            + "\n\nCheck: systemctl --user list-timers whiskeyjack-resolutions.timer"
            + "\n       systemctl --user enable --now whiskeyjack-resolutions.timer"
            + "\n       journalctl --user -u whiskeyjack-resolutions.service -n 80"
            + (
                "\n\nFor a timer that IS running but has not fired, the schedule itself is "
                "what to look at -- a calendar expression that no longer matches, or a clock "
                "that moved:"
                "\n       systemctl --user show whiskeyjack-resolutions.timer -p TimersCalendar"
                "\n       systemd-analyze calendar '*-*-* 00/6:23:00'"
                "\n       systemctl --user restart whiskeyjack-resolutions.timer"
                if "timer_stalled" in codes
                else ""
            )
        )
        # Stamp only a push that landed, so a dead channel retries on the next run.
        if _push(
            "whiskeyjack: RESOLUTIONS SCHEDULE STOPPED", body, priority="high", tags="hourglass"
        ):
            entry["last_alert"] = _now().isoformat()

    state["resolutions"] = entry
    _say("RESOLUTIONS STOPPED: " + ", ".join(codes))
    return True


def _check_tournament(state: dict) -> bool:
    """The five-minute forecasting poll. True when it is not running normally.

    Unchanged from the single-subject watchdog this grew out of, deliberately and to the
    line: same four queries, same 20-minute staleness threshold, same 60-minute re-alert,
    same `alerting`/`last_alert` keys at the top level of the state file, same dead-man
    ping on the healthy path. Only `_load_state`/`_save_state` moved out to `main`, which
    now owns the file for both subjects.
    """
    problems: list[str] = []

    timer_active = _systemctl("is-active", f"{UNIT}.timer")
    timer_enabled = _systemctl("is-enabled", f"{UNIT}.timer")
    service_active = _systemctl("is-active", f"{UNIT}.service")
    service_failed = _systemctl("is-failed", f"{UNIT}.service")

    if timer_active != "active":
        problems.append(f"timer is {timer_active}, not active")
    if timer_enabled != "enabled":
        problems.append(f"timer is {timer_enabled}, not enabled (it will not survive a reboot)")
    if service_failed == "failed":
        problems.append("last service run FAILED")

    beat = _last_heartbeat()
    age_text = "never"
    if beat is None:
        # Covers both "no row" and "a row whose timestamp this program cannot use": the
        # message has to be true of the case the operator is actually looking at, and the
        # runbook's symptom index quotes it.
        problems.append("no usable heartbeat timestamp in the ledger")
    else:
        age = _now() - beat
        minutes = age.total_seconds() / 60
        age_text = f"{minutes:.0f} min ago"
        # A run in progress legitimately holds the heartbeat still; not a fault.
        if age > STALE_AFTER and service_active != "active":
            problems.append(
                f"last heartbeat was {minutes:.0f} min ago "
                f"(threshold {STALE_AFTER.total_seconds() / 60:.0f} min) "
                f"and the service is {service_active} -- the worker is not polling"
            )

    previously_bad = bool(state.get("alerting"))
    # Same parser as the resolutions throttle. The RULE is unchanged -- a stamp this program
    # cannot use means no prior alert -- but it is now total over what the file can hold.
    last_alert = _aware_stamp(state.get("last_alert"))

    if problems:
        due = last_alert is None or (_now() - last_alert) >= REALERT_AFTER
        if due:
            body = (
                "The whiskeyjack worker is NOT running normally.\n\n"
                + "\n".join(f"- {p}" for p in problems)
                + f"\n\nlast heartbeat: {age_text}"
                + f"\ntimer: {timer_active}/{timer_enabled}  service: {service_active}"
                + "\n\nCheck: systemctl --user status whiskeyjack-tournament.timer"
                + "\n       whiskeyjack-bot tournament status --config config/tournament.yaml"
            )
            if _push("whiskeyjack: WORKER DOWN", body, priority="urgent", tags="rotating_light"):
                state["last_alert"] = _now().isoformat()
        state["alerting"] = True
        _say("DOWN: " + "; ".join(problems))
        return True

    if previously_bad and RECOVERY_NOTICE:
        _push(
            "whiskeyjack: worker recovered",
            f"The worker is polling again. last heartbeat: {age_text}",
            priority="default",
            tags="white_check_mark",
        )
    state["alerting"] = False
    state.pop("last_alert", None)
    # Still gated on the TOURNAMENT result alone. The dead-man answers "is this watchdog
    # running at all" for an external service that cannot see a dark host any other way;
    # withholding the ping for a stopped resolutions timer would raise a second, differently
    # worded alarm about the wrong thing.
    _ping_deadman()
    _say(f"OK: heartbeat {age_text}, timer {timer_active}/{timer_enabled}")
    return False


def _positive_int(value: object) -> int | None:
    """`value` when it is a positive int, else None. `bool` is refused: JSON `true` is not 1."""
    return value if type(value) is int and value > 0 else None


def _activation_project_id(raw: object) -> int | None:
    """The `project_id` of one stored `activation` event's `data` column, or None. Pure, total.

    Read back out of the ledger, so untrusted (CLAUDE.md): not a string, not JSON, not an
    object, no key, a string `"33125"`, `true` and a non-positive number are all "cannot say",
    which the caller reports as a check that could not run -- never as a match.
    """
    if not isinstance(raw, str):
        return None
    try:
        data = json.loads(raw)
    except (ValueError, RecursionError):
        return None
    return _positive_int(data.get("project_id")) if isinstance(data, dict) else None


def _project_id(payload: object) -> int | None:
    """The concrete project id in a Metaculus project answer, or None. Pure, total."""
    return _positive_int(payload.get("id")) if isinstance(payload, dict) else None


def _open_post_count(payload: object) -> int | None:
    """How many posts in one `/posts/` answer say they are open, or None. Pure, total.

    Counted from each post's OWN `status` rather than trusted to the `statuses=open` filter: if
    the filter were ever ignored, a page of closed posts would otherwise read as open ones and
    page about a series with nothing to forecast. A `results` that is not a list, or holds
    anything but objects each carrying a string `status`, is not an answer to the question
    asked -- and must not read as "nothing open", which is the quiet outcome (M1-347 review
    round 1: `{"status": null}`, `[]` and a missing status all counted as zero and went green).
    An unfamiliar string is still a status, and still not "open".
    """
    if not isinstance(payload, dict):
        return None
    results = payload.get("results")
    if not isinstance(results, list) or not all(
        isinstance(post, dict) and type(post.get("status")) is str for post in results
    ):
        return None
    return sum(1 for post in results if post.get("status") == "open")


def _rollover_key(activation_project: int, slug_project: int) -> str:
    """The throttle key of a rollover: the code AND the project pair.

    The pair is in the key so that a series that rolls over again while the first rollover is
    still standing pages at once -- it is a different move, and an owner who re-pointed at the
    first one needs to hear about the second.
    """
    return f"{_throttle_key(('rollover',))}:{activation_project}->{slug_project}"


def _is_rollover(activation_project: int, slug_project: int, open_posts: int | None) -> bool:
    """The criterion. Pure. A mismatch pages only while the slug's project has an open post.

    A new series with nothing open yet has nothing to lose, and paging then would page at every
    series boundary before the first batch -- when, if the owner re-points at once, `--starts`
    is the only thing that matters (docs/RUNBOOK.md P3).
    """
    if activation_project == slug_project:
        return False
    return open_posts is not None and open_posts >= 1


class _NoRedirect(urllib.request.HTTPRedirectHandler):
    """Refuse every redirect, so the token cannot follow one.

    urllib's redirect handler copies every header but the content ones onto the new request,
    `Authorization` included, whatever host the `Location` names. Neither path this script asks
    for redirects (measured on 2026-09-22; `/projects/tournaments/minibench` without its slash
    does, with a 301), so refusing costs nothing and a redirect reads as a failed check.
    """

    def redirect_request(self, *args: object, **kwargs: object) -> None:
        return None


def _metaculus_get(path: str, deadline: float) -> object:
    """One read-only GET against the Metaculus API, parsed. Raises on anything but a JSON answer.

    The token is sent as a header and never printed; an HTTPError's text is never rendered, by
    the caller or here. `deadline` is `time.monotonic()` seconds; the socket timeout is what is
    left of it, and the thread join in `_read_rollover` is what actually enforces it.
    """
    remaining = deadline - time.monotonic()
    if remaining <= 0:
        raise TimeoutError
    headers = {"Accept": "application/json", "User-Agent": ROLLOVER_USER_AGENT}
    token = os.environ.get("METACULUS_TOKEN", "").strip()
    if token:
        headers["Authorization"] = f"Token {token}"
    request = urllib.request.Request(f"{METACULUS_API}{path}", headers=headers, method="GET")
    opener = urllib.request.build_opener(_NoRedirect)
    with opener.open(request, timeout=remaining) as response:
        body = response.read(ROLLOVER_RESPONSE_LIMIT + 1)
    if len(body) > ROLLOVER_RESPONSE_LIMIT:
        raise ValueError
    return json.loads(body)


def _latest_activation_row(deadline: float) -> object:
    """The `data` of the newest `activation` event, or None. Read-only; raises on I/O failure.

    The same row `tournament_state.require_activation` reads (`kind='activation'`,
    `scope='account'`, newest by `seq`), so "the project the worker polls" and "the project
    this compares" are one fact.
    """
    timeout = max(0.0, min(float(LEDGER_TIMEOUT_SECONDS), deadline - time.monotonic()))
    conn = sqlite3.connect(f"file:{LEDGER}?mode=ro", uri=True, timeout=timeout)
    try:
        row = conn.execute(
            "select data from tournament_events "
            "where kind='activation' and scope='account' order by seq desc limit 1"
        ).fetchone()
    finally:
        conn.close()
    return row[0] if row else None


def _rollover_observation(deadline: float) -> tuple[int, int, int | None] | str:
    """`(activation project, slug project, open posts)`, or the code for why it cannot say.

    Open posts are only asked for when the two projects differ, because only then do they
    decide anything -- so the steady state is one GET per run, not two. Each stage catches
    `Exception` broadly on purpose: this is the boundary where anything that goes wrong is,
    by definition, a check that could not run, and nothing here may escape into `main`.
    """
    try:
        activation = _activation_project_id(_latest_activation_row(deadline))
    except Exception:
        activation = None
    if activation is None:
        return "activation_unreadable"
    try:
        slug_project = _project_id(
            _metaculus_get(f"/projects/tournaments/{MINIBENCH_SLUG}/", deadline)
        )
    except Exception:
        slug_project = None
    if slug_project is None:
        return "project_unreadable"
    if slug_project == activation:
        return (activation, slug_project, None)
    try:
        open_posts = _open_post_count(
            _metaculus_get(
                f"/posts/?tournaments={slug_project}&statuses=open&limit={ROLLOVER_OPEN_PAGE}",
                deadline,
            )
        )
    except Exception:
        open_posts = None
    if open_posts is None:
        return "posts_unreadable"
    return (activation, slug_project, open_posts)


def _read_rollover() -> tuple[int, int, int | None] | str:
    """`_rollover_observation`, under a wall-clock bound of ROLLOVER_FETCH_SECONDS.

    A daemon thread, joined with a timeout: the process exits a moment after `main` returns, so
    a read abandoned here dies with it rather than outliving the run. The per-socket timeouts
    inside are what keep the abandoned thread short; the join is what makes the bound true.
    """
    outcome: list[tuple[int, int, int | None] | str] = []
    deadline = time.monotonic() + ROLLOVER_FETCH_SECONDS

    def work() -> None:
        try:
            outcome.append(_rollover_observation(deadline))
        except BaseException:
            outcome.append("project_unreadable")

    worker = threading.Thread(target=work, name="wj-rollover", daemon=True)
    worker.start()
    worker.join(max(0.0, deadline - time.monotonic()))
    if worker.is_alive() or not outcome:
        return "timed_out"
    return outcome[0]


def _check_rollover(state: dict) -> bool:
    """MiniBench's slug against the live activation (M1-347). True when paging or blind.

    Two throttles, deliberately. `rollover` is keyed on the code and the project pair;
    `rollover_check_failed` is keyed on its one code and lives in its own state entry. So a
    failed read neither clears a standing rollover nor re-keys it: the M1-343 lesson is that a
    code dropping out for a reason unrelated to the fault changes the key and re-pages, and a
    Metaculus timeout says nothing about which project MiniBench is on. When the read succeeds
    again, the rollover's own entry is exactly as the last good read left it.

    Nothing here changes anything. Re-pointing the activation is an owner action
    (docs/RUNBOOK.md P3), and the push says so.
    """
    now = _now()
    stored = state.get("rollover")
    if not isinstance(stored, dict):
        stored = {}
    stored_check = state.get("rollover_check")
    if not isinstance(stored_check, dict):
        stored_check = {}

    observation = _read_rollover()
    if isinstance(observation, str):
        reason = observation if observation in ROLLOVER_CHECK_PROBLEMS else "project_unreadable"
        key = _throttle_key(("rollover_check_failed",))
        entry: dict = {"key": key}
        previous = stored_check.get("last_alert")
        if stored_check.get("key") == key and isinstance(previous, str):
            entry["last_alert"] = previous
        if _key_is_due(key, stored_check, now, ROLLOVER_CHECK_REALERT_AFTER):
            body = (
                "The MiniBench rollover check could not run, so a rollover to a new Metaculus "
                "project would go unreported until it can.\n\n"
                f"- {ROLLOVER_CHECK_PROBLEMS[reason]}"
                "\n\nThis is not the worker: nothing here says the worker is down, and it pages "
                "WORKER DOWN on its own. Usually a Metaculus outage or a slow answer; it clears "
                "by itself on the next good read."
                "\n\nCheck: journalctl --user -u whiskeyjack-watchdog.service -n 40"
                "\n       whiskeyjack-bot tournament status --config config/tournament.yaml"
            )
            if _push(
                "whiskeyjack: rollover check failed",
                body,
                priority="default",
                tags="grey_question",
                timeout=ROLLOVER_PUSH_TIMEOUT_SECONDS,
            ):
                entry["last_alert"] = _now().isoformat()
        state["rollover_check"] = entry
        _say("ROLLOVER CHECK FAILED: " + reason)
        return True

    state["rollover_check"] = {}
    activation_project, slug_project, open_posts = observation

    if activation_project == slug_project:
        # The only evidence that ends a rollover: the activation now covers the slug's project.
        if stored.get("key") and RECOVERY_NOTICE:
            _push(
                "whiskeyjack: MiniBench rollover cleared",
                "The live activation covers MiniBench's current project again. Questions that "
                "opened and closed in between are not recoverable; nothing else is owed.",
                priority="default",
                tags="white_check_mark",
                timeout=ROLLOVER_PUSH_TIMEOUT_SECONDS,
            )
        state["rollover"] = {}
        _say("OK: MiniBench is on the activation's project")
        return False

    if not _is_rollover(activation_project, slug_project, open_posts):
        # A mismatch with nothing open. Quiet, and the stored entry is LEFT as it is: an empty
        # batch is not evidence the activation was re-pointed, so it must not clear a standing
        # rollover (and so re-page it) when the next batch opens.
        _say("OK: MiniBench is on a new project with nothing open yet")
        return False

    key = _rollover_key(activation_project, slug_project)
    entry = {"key": key}
    previous = stored.get("last_alert")
    if stored.get("key") == key and isinstance(previous, str):
        entry["last_alert"] = previous
    if _key_is_due(key, stored, now, ROLLOVER_REALERT_AFTER):
        # No value read out of Metaculus or the ledger is rendered here -- not the new project
        # id, not the old one, not the count. The owner reads both from the two commands below.
        body = (
            "MiniBench has moved to a Metaculus project the live activation does not cover, "
            "and that project has open questions. The worker is still polling the old project "
            "and discovers 0 questions every poll, so it looks healthy -- but each MiniBench "
            "question is open for three hours, and one that closes before the re-point is lost."
            "\n\nNothing was changed. Re-pointing is an owner action: docs/RUNBOOK.md P3 "
            "(set --starts to now or earlier)."
            "\n\nCheck: whiskeyjack-bot tournament status --config config/tournament.yaml"
            "\n       the project id of the open questions on Metaculus's MiniBench page"
        )
        if _push(
            "whiskeyjack: MINIBENCH ROLLED OVER",
            body,
            priority="urgent",
            tags="warning",
            timeout=ROLLOVER_PUSH_TIMEOUT_SECONDS,
        ):
            entry["last_alert"] = _now().isoformat()
    state["rollover"] = entry
    _say("ROLLOVER: MiniBench is on a project the activation does not cover")
    return True


def main() -> int:
    """Every subject, every run, whatever the others say.

    No check may skip because another failed: a broken poll, a stopped resolutions timer and a
    MiniBench rollover are independent conditions with independent fixes, and the day the
    outage of 2026-09-09 repeats is exactly the day the other halves must still be reported.
    """
    state = _load_state()
    # Before either check, and at the top level of the state file: the record of whether this
    # watchdog was running is about the watchdog, not about either subject, and both checks
    # rewrite their own keys wholesale (M1-343).
    observed_since = _observe(state, _now())
    tournament_down = _check_tournament(state)
    resolutions_down = _check_resolutions(state, observed_since)
    # Last, and with nothing downstream of it: the only subject that waits on the network, so
    # the other two have already paged by the time it could be slow.
    rollover_down = _check_rollover(state)
    # M1-344: after the save, because only the save knows whether it failed. Reported, never
    # returned: a state file that cannot be written is not one of the three subjects, and
    # it must not be the reason this run exits non-zero.
    _report_persistence(state, *_save_state(state))
    return 1 if tournament_down or resolutions_down or rollover_down else 0


if __name__ == "__main__":
    _status = main()
    _quiet_shutdown()
    sys.exit(_status)
