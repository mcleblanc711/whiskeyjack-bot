#!/usr/bin/env python3
"""Out-of-process liveness watchdog for the whiskeyjack worker.

Why this exists, and why it is NOT part of the worker: an in-process notifier cannot
report its own death. `notify.py` fires when the code notices something; it says nothing
at all when the timer is disabled, the activation is retired, the user session ends, or
the process never starts. That is the 2026-09-09 outage -- 2h33m, ~28 refused polls,
and the only page was systemd's OnFailure with a body of `result=exit-code exit=1`.
The worker's own `poll_summary` digest is throttled to 24h, so as an AFK monitor it is
useless: it reports a stop up to a day late.

This runs as a SEPARATE systemd timer and reads the ledger READ-ONLY. It touches no
AppConfig field, so it cannot change `config_sha256` and cannot retire an activation
(M1-334).

The detector is heartbeat staleness. Measured against the real outage: heartbeats
stopped completely for a clean 160-minute gap (2026-09-09T23:00:19Z ->
2026-09-10T01:40:15Z), so this signal does catch the failure that actually happened.

Long forecasting runs are NOT false alarms: a poll can legitimately run for tens of
minutes (the unit allows 2400s), and systemd will not start a second instance while one
is running, so the heartbeat goes stale while the worker is healthy. Staleness is
therefore only an alert when the service is not currently active.
"""

from __future__ import annotations

import json
import os
import sqlite3
import subprocess
import sys
import urllib.error
import urllib.request
from datetime import datetime, timedelta, timezone
from pathlib import Path

ROOT = Path("/home/cleblanc/projects/whiskeyjack-bot")
LEDGER = ROOT / "data/whiskeyjack_bot.sqlite3"
STATE = Path.home() / ".local/state/wj-watchdog.json"

UNIT = "whiskeyjack-tournament"
STALE_AFTER = timedelta(minutes=20)     # 4 missed polls at a 5-minute cadence
REALERT_AFTER = timedelta(minutes=60)   # keep reminding, do not spam
RECOVERY_NOTICE = True


def _now() -> datetime:
    return datetime.now(timezone.utc)


def _systemctl(*args: str) -> str:
    try:
        out = subprocess.run(
            ["systemctl", "--user", *args],
            capture_output=True, text=True, timeout=15,
        )
        return out.stdout.strip()
    except Exception:
        return "unknown"


def _last_heartbeat() -> datetime | None:
    """Newest heartbeat timestamp, or None. Read-only; never writes to the ledger."""
    if not LEDGER.exists():
        return None
    try:
        conn = sqlite3.connect(f"file:{LEDGER}?mode=ro", uri=True, timeout=10)
        try:
            row = conn.execute(
                "select created_at_utc from tournament_events "
                "where kind='heartbeat' order by seq desc limit 1"
            ).fetchone()
        finally:
            conn.close()
    except sqlite3.Error:
        return None
    if not row:
        return None
    try:
        return datetime.fromisoformat(row[0])
    except ValueError:
        return None


def _load_state() -> dict:
    try:
        return json.loads(STATE.read_text())
    except Exception:
        return {}


def _save_state(state: dict) -> None:
    try:
        STATE.parent.mkdir(parents=True, exist_ok=True)
        STATE.write_text(json.dumps(state))
    except OSError:
        pass


def _push(title: str, body: str, *, priority: str, tags: str) -> bool:
    """Send one ntfy push. Never raises -- a dead channel must not kill the watchdog."""
    topic = os.environ.get("NTFY_TOPIC_URL", "").strip()
    if not topic:
        return False
    request = urllib.request.Request(
        topic,
        data=body.encode("utf-8"),
        headers={"Title": title, "Priority": priority, "Tags": tags},
        method="POST",
    )
    try:
        with urllib.request.urlopen(request, timeout=15) as response:
            return 200 <= response.status < 300
    except (urllib.error.URLError, OSError, ValueError):
        return False


def _ping_deadman() -> None:
    """Optional external dead-man ping.

    The watchdog cannot report that the MACHINE is off or the user session ended -- it
    dies with them. Set WJ_HEALTHCHECK_URL (healthchecks.io or similar) and that service
    alerts when these pings stop, which is the only thing that covers a dark host.
    """
    url = os.environ.get("WJ_HEALTHCHECK_URL", "").strip()
    if not url:
        return
    try:
        urllib.request.urlopen(url, timeout=10).close()
    except (urllib.error.URLError, OSError, ValueError):
        pass


def main() -> int:
    problems: list[str] = []

    timer_active = _systemctl("is-active", f"{UNIT}.timer")
    timer_enabled = _systemctl("is-enabled", f"{UNIT}.timer")
    service_active = _systemctl("is-active", f"{UNIT}.service")
    service_failed = _systemctl("is-failed", f"{UNIT}.service")

    if timer_active != "active":
        problems.append(f"timer is {timer_active}, not active")
    if timer_enabled != "enabled":
        problems.append(f"timer is {timer_enabled}, not enabled (it will not survive a reboot)")
    if service_failed == "failed":
        problems.append("last service run FAILED")

    beat = _last_heartbeat()
    age_text = "never"
    if beat is None:
        problems.append("no heartbeat row in the ledger at all")
    else:
        age = _now() - beat
        minutes = age.total_seconds() / 60
        age_text = f"{minutes:.0f} min ago"
        # A run in progress legitimately holds the heartbeat still; not a fault.
        if age > STALE_AFTER and service_active != "active":
            problems.append(
                f"last heartbeat was {minutes:.0f} min ago "
                f"(threshold {STALE_AFTER.total_seconds() / 60:.0f} min) "
                f"and the service is {service_active} -- the worker is not polling"
            )

    state = _load_state()
    previously_bad = bool(state.get("alerting"))
    last_alert_raw = state.get("last_alert")
    last_alert = None
    if last_alert_raw:
        try:
            last_alert = datetime.fromisoformat(last_alert_raw)
        except ValueError:
            last_alert = None

    if problems:
        due = last_alert is None or (_now() - last_alert) >= REALERT_AFTER
        if due:
            body = (
                "The whiskeyjack worker is NOT running normally.\n\n"
                + "\n".join(f"- {p}" for p in problems)
                + f"\n\nlast heartbeat: {age_text}"
                + f"\ntimer: {timer_active}/{timer_enabled}  service: {service_active}"
                + "\n\nCheck: systemctl --user status whiskeyjack-tournament.timer"
                + "\n       whiskeyjack-bot tournament status --config config/tournament.yaml"
            )
            if _push("whiskeyjack: WORKER DOWN", body, priority="urgent", tags="rotating_light"):
                state["last_alert"] = _now().isoformat()
        state["alerting"] = True
        _save_state(state)
        print("DOWN: " + "; ".join(problems))
        return 1

    if previously_bad and RECOVERY_NOTICE:
        _push(
            "whiskeyjack: worker recovered",
            f"The worker is polling again. last heartbeat: {age_text}",
            priority="default",
            tags="white_check_mark",
        )
    state["alerting"] = False
    state.pop("last_alert", None)
    _save_state(state)
    _ping_deadman()
    print(f"OK: heartbeat {age_text}, timer {timer_active}/{timer_enabled}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
